menuconfig BEAU
	bool "BEAU hypervisor guest drivers"
	depends on ARM64
	default y
	help
	  Enable BEAU hypervisor paravirtual guest support.

if BEAU

config BEAU_PM
	bool "BEAU coordinated guest suspend-to-RAM agent"
	depends on SUSPEND
	default y
	help
	  Expose the BEAU PM event device used by the init service to enter
	  PSCI SYSTEM_SUSPEND and acknowledge the retained resume epoch.

config BEAU_VWDT
	bool "BEAU hypervisor watchdog heartbeat"
	default y
	help
	  Periodically kick the BEAU hypervisor VM watchdog from the Linux guest.
	  This is a heartbeat only: if Linux stops scheduling the heartbeat worker,
	  BEAU can mark the VM as stuck.

config BEAU_EDU_TEST
	bool "BEAU QEMU edu PCI passthrough test"
	depends on PCI && PCI_MSI
	default y
	help
	  Probe the QEMU edu PCI endpoint used by BEAU VM2 passthrough
	  validation. The driver enables BAR MMIO, allocates one MSI/MSI-X
	  vector, raises one device interrupt, and reports whether the
	  interrupt handler observed it.

config BEAU_IPC_TEST
	bool "BEAU static IPC validation endpoint"
	default y
	help
	  Join the first BEAU IPC channel visible to this VM, map its shared
	  SPSC rings, and exchange length-prefixed validation messages with the
	  peer endpoint through HC_IPC notifications.

config BEAU_VIRTIOFS_BACKEND
	bool "BEAU VM2 virtio-fs backend"
	depends on VIRTIO_FS
	help
	  Service BEAU virtio-proxy requests from a backend Linux VM.

	  This first backend is intentionally small: it lets a frontend VM mount
	  a virtio-fs export backed by the backend VM's /var/beau
	  directory. BEAU still owns only the MMIO transport and descriptor
	  copying; this driver owns FUSE request semantics and VFS access.

config BEAU_VIRTIORNG_BACKEND
	bool "BEAU VM2 virtio-rng backend"
	help
	  Service BEAU virtio-proxy RNG requests from a backend Linux VM.

	  Enable this with a frontend virtio-proxy device advertising virtio RNG
	  device id 4. VM3's standard virtio-rng frontend supplies writable
	  buffers; VM2 fills them with kernel random bytes and completes the
	  descriptor through BEAU.

config BEAU_VIRTIOBLK_BACKEND
	bool "BEAU VM2 virtio-blk RAM backend"
	default y
	help
	  Service BEAU virtio-proxy block requests from a backend Linux VM.

	  Enable this with a frontend virtio-proxy device advertising virtio BLK
	  device id 2. VM3's standard virtio-blk frontend sends request headers,
	  data buffers, and status descriptors; VM2 stores data in a small RAM
	  disk and completes the descriptor through BEAU.

config BEAU_VIRTIOI2C_BACKEND
	bool "BEAU VM2 virtio-i2c EEPROM backend"
	default y
	help
	  Service BEAU virtio-proxy I2C requests from a backend Linux VM.

	  Enable this with a frontend virtio-proxy device advertising virtio I2C
	  adapter device id 34. VM3's standard virtio-i2c frontend sends I2C
	  message descriptors; VM2 exposes a small in-memory device at 7-bit
	  address 0x50 for QEMU validation with i2c-tools.

config BEAU_VIRTIONET_BACKEND
	bool "BEAU VM2 virtio-net uplink backend"
	depends on NET
	default y
	help
	  Service BEAU virtio-proxy network requests from a backend Linux VM.

	  Enable this with a frontend virtio-proxy device advertising virtio NET
	  device id 1. VM3's standard virtio-net frontend exchanges Ethernet
	  frames with VM2. VM2 forwards those frames through one uplink netdev,
	  selected by the backend's uplink parameter and defaulting to eth0.

endif
