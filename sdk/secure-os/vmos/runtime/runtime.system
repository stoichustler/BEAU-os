<system>
    <memory_region name="pl011" size="0x1000" phys_addr="0x0900_0000" />

    <protection_domain name="vmos_runtime" priority="100" cpu="0">
        <program_image path="vmos-runtime.elf" />
        <map mr="pl011" vaddr="0x1000_0000" perms="rw" cached="false" />
        <irq irq="33" id="0" trigger="level" />
    </protection_domain>

    <protection_domain
        name="ipc_benchmark_responder"
        priority="101"
        cpu="0"
        passive="true"
    >
        <program_image path="ipc-benchmark-responder.elf" />
    </protection_domain>

    <channel>
        <end pd="vmos_runtime" id="1" pp="true" notify="false" />
        <end pd="ipc_benchmark_responder" id="0" notify="false" />
    </channel>
</system>
