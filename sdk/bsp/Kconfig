menu "BSP"

config HAS_HSM
	bool "Enable HSM-backed I/O request path"
	default n
	help
	  Enable code paths that depend on the legacy HSM I/O request model.
	  Static ARM64 platforms use BEAU-owned MMIO dispatch and leave this
	  disabled.

config SERIAL_8250_PCI
	bool "Use PCI 8250 serial port"
	default n
	help
	  Route the debug serial driver through a PCI 8250 device. ARM64 QEMU
	  and rk356x use MMIO serial devices instead.

config CONSOLE_DEFAULT_VM
	string "Default console VM"
	default "ACRN_INVALID_VMID"
	help
	  Initial VM console owner. ACRN_INVALID_VMID means the BEAU shell owns
	  host input and output until a vsh command selects a VM.

config CONSOLE_LOGLEVEL_DEFAULT
	int "Default console log level"
	default 6
	help
	  Initial console log level used by BEAU logging.

config MEM_LOGLEVEL_DEFAULT
	int "Default memory log level"
	default 0
	help
	  Initial memory log category verbosity.

config HOST_DMESG_RING_SIZE
	int "Host dmesg ring size"
	default 65536
	range 4096 1048576
	help
	  Static storage budget in bytes for retained BEAU host log records. The
	  dmesg shell command reads the newest complete records after the live
	  console stream has moved on. Full rings overwrite the oldest records.

config COREMARK
	bool "CoreMark parallel diagnostic"
	default y if STATIC_ARM64_PLATFORM
	help
	  Build the fixed CoreMark upstream snapshot and expose the asynchronous
	  coremark [iterations] shell command. It runs one context on every active
	  pCPU and reports scheduler-inclusive EL2 diagnostic results.

if COREMARK

config COREMARK_MAX_ITERATIONS
	int "Maximum explicit CoreMark iterations"
	default 1000000
	range 1 10000000
	help
	  Upper bound for an explicit coremark iteration argument. Zero selects the
	  upstream automatic calibration path, which targets at least ten seconds.

config COREMARK_START_TIMEOUT_MS
	int "CoreMark pCPU start timeout in milliseconds"
	default 250
	range 10 10000
	help
	  Maximum time a dispatched pCPU worker may remain queued before the
	  generation reports that pCPU as unavailable. The worker context remains
	  reserved until a delayed wakeup completes.

config COREMARK_RUN_TIMEOUT_MS
	int "CoreMark pCPU completion timeout in milliseconds"
	default 30000
	range 1000 120000
	help
	  Maximum time a running pCPU worker may take before the generation reports
	  a partial result. BEAU does not forcibly stop a late worker; its fixed
	  context remains reserved until completion.

endif

config DHRYSTONE
	bool "Dhrystone serialized diagnostic"
	default y if STATIC_ARM64_PLATFORM
	help
	  Build the Dhrystone 2.2a port and expose the asynchronous dhrystone
	  [initial-runs] shell command. The upstream global state runs on one pCPU
	  at a time and reports each pCPU separately.

if DHRYSTONE

config DHRYSTONE_MAX_INITIAL_RUNS
	int "Maximum Dhrystone initial runs"
	default 10000000
	range 1 100000000
	help
	  Upper bound for the optional initial run count. Dhrystone preserves its
	  upstream two-second measurement rule and may increase this value by ten.

config DHRYSTONE_START_TIMEOUT_MS
	int "Dhrystone pCPU start timeout in milliseconds"
	default 5000
	range 10 10000
	help
	  Maximum time a pinned worker may remain queued before BEAU atomically
	  cancels it before execution. This covers BVT catch-up after a prior
	  diagnostic run without permitting deferred background work.

config DHRYSTONE_RUN_TIMEOUT_MS
	int "Dhrystone pCPU completion timeout in milliseconds"
	default 30000
	range 1000 120000
	help
	  Maximum time one pCPU Dhrystone execution may take before BEAU marks it
	  late. A late worker retains command ownership until it completes, so a
	  completed command never leaves benchmark work running in the background.

endif

config NPK_LOGLEVEL_DEFAULT
	int "Default NPK log level"
	default 0
	help
	  Initial NPK log category verbosity. Static ARM64 builds keep this at
	  zero unless tracing support is added.

config VUART_TIMER_PCPU
	string "vUART timer pCPU"
	default "BSP_CPU_ID"
	help
	  CPU that owns the periodic vUART and console timer. BSP_CPU_ID keeps
	  timer ownership on the boot CPU.

config VUART_RX_BUF_SIZE
	int "vUART RX buffer size"
	default 256
	help
	  Receive buffer size in bytes for each virtual UART.

config VUART_TX_BUF_SIZE
	int "vUART TX buffer size"
	default 256
	help
	  Transmit buffer size in bytes for each virtual UART.

config VM_CONSOLE_RINGBUF_VM_NUM
	string "VM console ring buffer count"
	default "(PRE_VM_NUM + SERVICE_VM_NUM)"
	help
	  Number of per-VM console ring buffers. The default covers all static
	  pre-launched and service VMs.

config VM_CONSOLE_RINGBUF_SIZE
	int "VM console ring buffer size"
	default 4096
	help
	  Per-VM console ring buffer size in bytes. This must stay a power of
	  two for the ring mask logic in sdk/bsp/console.c.

config MAX_MSIX_TABLE_NUM
	int "Maximum MSI-X table entries"
	default 16
	help
	  Static allocation limit for emulated or passthrough MSI-X table
	  entries.

config MAX_PCI_DEV_NUM
	int "Maximum PCI devices"
	default 16
	help
	  Static allocation limit for BEAU PCI physical and virtual device
	  records.

config MAX_IOAPIC_NUM
	int "Maximum IOAPIC count"
	default 0
	help
	  Static IOAPIC allocation count. ARM64 static platforms use GIC and set
	  this to zero.

config SPACE_SIZE
	hex "PCI MMCONFIG space size"
	default 0x10000000
	help
	  Compatibility value used by shared PCI code for MMCONFIG space sizing.

config ADDR
	hex "PCI config address port"
	default 0xcf8
	help
	  Compatibility value for legacy PCI configuration address port.

config DATA
	hex "PCI config data port"
	default 0xcfc
	help
	  Compatibility value for legacy PCI configuration data port.

config IGD_SBDF
	hex "Integrated graphics SBDF"
	default 0
	help
	  Compatibility SBDF used by shared passthrough PCI code. Static ARM64
	  platforms do not currently pass through IGD.

config PRE_VM_NUM
	int "Pre-launched VM count"
	default 2
	help
	  Number of pre-launched VMs in the static ARM64 scenario.

config SERVICE_VM_NUM
	int "Service VM count"
	default 1
	help
	  Number of service VMs in the static ARM64 scenario.

config MAX_POST_VM_NUM
	int "Maximum post-launched VM count"
	default 0
	help
	  Static allocation limit for post-launched VMs. Current ARM64 static
	  platforms do not use post-launched VMs.

config MAX_TRUSTY_VM_NUM
	int "Maximum Trusty VM count"
	default 0
	help
	  Static allocation limit for Trusty VMs. Current ARM64 static platforms
	  do not use Trusty VMs.

config MAX_VUART_NUM_PER_VM
	int "Maximum vUARTs per VM"
	default 2
	help
	  Number of virtual UART configuration slots per VM.

config RTVM_SEVERITY_LEVEL
	hex "RTVM severity level"
	default 0x30
	help
	  Compatibility severity value used for real-time VM configuration.

menuconfig CPUFREQ
	bool "BSP CPU frequency policy"
	default y if STATIC_ARM64_PLATFORM
	help
	  Enable the BEAU BSP CPU frequency policy. The first implementation is
	  host-only and consumes static platform DTS policy.

if CPUFREQ

config CPUFREQ_EXPECTED_CPUS
	int "Expected CPUFreq CPU count"
	default 8 if PLATFORM_QEMU
	default 4 if PLATFORM_RK356X
	default 8
	range 1 64
	help
	  Number of host pCPUs that the enabled CPUFreq DTS domain must cover.

choice CPUFREQ_POLICY
	prompt "CPUFreq policy"
	default CPUFREQ_POLICY_PERFORMANCE

config CPUFREQ_POLICY_PERFORMANCE
	bool "Performance"
	help
	  Always select the highest configured P-state.

endchoice

choice CPUFREQ_BACKEND
	prompt "CPUFreq backend"
	default CPUFREQ_BACKEND_STUB

config CPUFREQ_BACKEND_STUB
	bool "Stub"
	help
	  Record the selected P-state without changing hardware frequency.

endchoice

endif

source "sdk/bsp/acpi/Kconfig"
source "sdk/bsp/arm64/Kconfig"
source "sdk/bsp/boot/Kconfig"
source "sdk/bsp/pci/Kconfig"
source "sdk/bsp/virtio/Kconfig"

endmenu
