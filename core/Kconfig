menu "Core"

config AUTOSTART_VM
	bool "Autostart static VMs"
	default y
	help
	  Start configured static VMs during BEAU boot. Disable only for bring-up
	  flows that need to create or start VMs manually from the shell.

config LAUNCH_VMS_FROM_BSP
	bool "Launch static VMs from the BSP"
	default y
	help
	  Launch static VMs from the boot CPU after platform initialization.
	  The current ARM64 static platform path expects this to be enabled.

config SCHED_DTS
	bool
	default y
	help
	  Compile all built-in scheduler backends. Runtime policy is selected
	  from /hypervisor/sched cpupool nodes in the static platform device tree.

config SCHED_NOOP
	bool
	default y if SCHED_DTS
	help
	  Internal compatibility symbol selecting no-op scheduler code.

config SCHED_IORR
	bool
	default y if SCHED_DTS
	help
	  Internal compatibility symbol selecting I/O round-robin scheduler code.

config SCHED_BVT
	bool
	default y if SCHED_DTS
	help
	  Internal compatibility symbol selecting BVT scheduler code.

config SCHED_RTDS
	bool
	default y if SCHED_DTS
	help
	  Internal compatibility symbol selecting RTDS scheduler code.

config SCHED_CBS
	bool
	default y if SCHED_DTS
	help
	  Internal compatibility symbol selecting CBS scheduler code.

config SCHED_BVT_MCU_MS
	int "BVT minimum charging unit in milliseconds"
	default 1
	range 1 100
	depends on SCHED_BVT
	help
	  Minimum charging unit used by the BVT virtual-time scheduler.
	  Smaller values improve responsiveness at the cost of more timer activity.

config SCHED_BVT_CSA_MCU
	int "BVT context-switch allowance in MCU units"
	default 5
	range 1 100
	depends on SCHED_BVT
	help
	  Extra BVT runtime allowance, expressed in BVT MCU units, used when
	  programming the one-shot scheduler timer. Increase it to reduce timer
	  churn; decrease it to reduce wake and fairness latency.

config SCHED_PRIO
	bool
	default y if SCHED_DTS
	help
	  Internal compatibility symbol selecting priority scheduler code.

config ACRNTRACE_ENABLED
	bool "Enable BEAU runtime trace capture"
	default y
	help
	  Compile the low-overhead per-pCPU trace producer and shell capture
	  controls. Capture remains stopped at boot until the trace shell command
	  starts it.

config TRACE_RECORDS_PER_CPU
	int "Trace records retained per pCPU"
	default 256
	range 32 4096
	depends on ACRNTRACE_ENABLED
	help
	  Number of fixed 32-byte records retained in each pCPU trace ring. Full
	  rings overwrite their oldest records and account the overwrite count.

config MAX_EMULATED_MMIO_REGIONS
	int "Maximum emulated MMIO regions per VM"
	default 8
	help
	  Static allocation limit for MMIO traps owned by BEAU emulation code.

config MAX_PT_IRQ_ENTRIES
	int "Maximum passthrough IRQ entries"
	default 32
	help
	  Static allocation limit for physical interrupt remapping records.

config VM_WDT_MONITOR_VM_NUM
	int "VM watchdog monitor count"
	default 3
	help
	  Number of VM IDs scanned by the VM watchdog task.

config VM_WDT_PRINT_PERIOD_MS
	int "VM watchdog print period in milliseconds"
	default 5000
	help
	  Minimum time between repeated watchdog diagnostic prints.

config VM_WDT_TIMEOUT_MS
	int "VM watchdog timeout in milliseconds"
	default 15000
	help
	  VM heartbeat age that is considered timed out by the watchdog.

config VM_WDT_RESTART_VM_MASK
	hex "VM watchdog auto-restart VM mask"
	default 0
	help
	  Bit n enables automatic restart of VM n after its watchdog heartbeat
	  times out. Enable only guests that include an HC_VM_WDT_KICK source.
	  Service VMs are never restarted by the watchdog.

config VM_WDT_RESTART_MAX
	int "Maximum watchdog recovery attempts per VM boot"
	default 3
	help
	  Limits automatic restarts after a VM watchdog timeout. The count survives
	  VM restarts for the lifetime of one VM instance, preventing a guest that
	  cannot boot from entering an infinite watchdog reset loop.

endmenu
