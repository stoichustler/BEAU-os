#
# Build
#
# CONFIG_RELEASE is not set

#
# Architecture
#
CONFIG_ARM64=y
CONFIG_STATIC_ARM64_PLATFORM=y
# CONFIG_RELOC is not set
CONFIG_HV_RAM_START=0x50000000
CONFIG_MAX_PCPU_NUM=8
CONFIG_STACK_SIZE=8192

#
# ARM64 platform
#
CONFIG_BOARD="qemu"
CONFIG_SCENARIO="qemu"
CONFIG_PLATFORM_QEMU=y
# CONFIG_PLATFORM_RK356X is not set
CONFIG_STATIC_QEMU_PLATFORM=y
# CONFIG_STATIC_RK356X_PLATFORM is not set

#
# Interrupt controller
#
# CONFIG_ARM64_GICV5 is not set
CONFIG_IRQSTAT_LATENCY=y

#
# Guest boot
#
CONFIG_GUEST_KERNEL_RAWIMAGE=y
# CONFIG_GUEST_KERNEL_BZIMAGE is not set
# CONFIG_GUEST_KERNEL_ELF is not set
CONFIG_STATIC_VFDT=y
# CONFIG_ENABLE_VM1_LK is not set

#
# Core
#
CONFIG_AUTOSTART_VM=y
CONFIG_LAUNCH_VMS_FROM_BSP=y
CONFIG_SCHED_DTS=y
CONFIG_SCHED_NOOP=y
CONFIG_SCHED_IORR=y
CONFIG_SCHED_BVT=y
CONFIG_SCHED_RTDS=y
CONFIG_SCHED_CBS=y
CONFIG_SCHED_BVT_MCU_MS=1
CONFIG_SCHED_BVT_CSA_MCU=3
CONFIG_SCHED_PRIO=y
CONFIG_MAX_EMULATED_MMIO_REGIONS=8
CONFIG_MAX_PT_IRQ_ENTRIES=32
CONFIG_VM_WDT_MONITOR_VM_NUM=3
CONFIG_VM_WDT_PRINT_PERIOD_MS=5000
CONFIG_VM_WDT_TIMEOUT_MS=15000

#
# Libraries
#
# CONFIG_FDT_PARSE_ENABLED is not set

#
# BSP
#
# CONFIG_HAS_HSM is not set
# CONFIG_SERIAL_8250_PCI is not set
CONFIG_CONSOLE_DEFAULT_VM="ACRN_INVALID_VMID"
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=6
CONFIG_MEM_LOGLEVEL_DEFAULT=0
CONFIG_NPK_LOGLEVEL_DEFAULT=0
CONFIG_VUART_TIMER_PCPU="BSP_CPU_ID"
CONFIG_VUART_RX_BUF_SIZE=256
CONFIG_VUART_TX_BUF_SIZE=256
CONFIG_VM_CONSOLE_RINGBUF_VM_NUM="(PRE_VM_NUM + SERVICE_VM_NUM)"
CONFIG_VM_CONSOLE_RINGBUF_SIZE=4096
CONFIG_MAX_MSIX_TABLE_NUM=16
CONFIG_MAX_PCI_DEV_NUM=16
CONFIG_MAX_IOAPIC_NUM=0
CONFIG_SPACE_SIZE=0x10000000
CONFIG_ADDR=0xcf8
CONFIG_DATA=0xcfc
CONFIG_IGD_SBDF=0
CONFIG_PRE_VM_NUM=2
CONFIG_SERVICE_VM_NUM=1
CONFIG_MAX_POST_VM_NUM=0
CONFIG_MAX_TRUSTY_VM_NUM=0
CONFIG_MAX_VUART_NUM_PER_VM=2
CONFIG_RTVM_SEVERITY_LEVEL=0x30

#
# BSP feature switches
#
# CONFIG_ACPI_PARSE_ENABLED is not set
# CONFIG_MULTIBOOT2 is not set
# CONFIG_SECURITY_VM_FIXUP is not set
# CONFIG_IVSHMEM_ENABLED is not set
# CONFIG_VMCS9900 is not set
